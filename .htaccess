# SmartTV CMS - root .htaccess
# Routes all requests through the front controller while serving real files/assets directly.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If running in a subfolder, set RewriteBase accordingly (installer can update this).
    # RewriteBase /

    # Do not rewrite existing files or directories (assets, uploads, installer, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Security hardening
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to sensitive files/folders
<FilesMatch "\.(sql|log|md|json|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^(config|app|storage)/ - [F,L]
</IfModule>

# Disable directory listing
Options -Indexes
